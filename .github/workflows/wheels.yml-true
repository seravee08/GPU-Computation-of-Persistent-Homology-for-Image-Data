name build-wheels

on
  push
    tags [v]          # runs when you push a tag like v2.1.0
  workflow_dispatch      # also allows manual Run workflow button

permissions
  contents write         # needed to upload assets to the Release

jobs
  build
    runs-on ubuntu-latest
    container
      image seravee08topogpuv2.0.0      # your CUDA + Python 3.10-3.13 toolchain image
    steps
      - uses actionscheckout@v4

      - name Build binary and wheels
        run 
          git config --global --add safe.directory $GITHUB_WORKSPACE
          bash scriptsbuild.sh

      - name Smoke test (import only, no GPU on runner)
        run 
          python -m pip install --break-system-packages disttopogpu--cp312-.whl
          python -c import topogpu; print('import ok')

      - name Upload wheels and binary to the GitHub Release
        uses softpropsaction-gh-release@v2
        with
          files 
            dist.whl
            buildtopoGPU